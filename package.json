{
  "name": "vite-project-manager",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "electron": "electron electron/main.cjs",
    "electron:dev": "cross-env NODE_ENV=development electron electron/main.cjs",
    "electron:build": "npm run build && electron-builder --win",
    "start": "node dist-server/server.js"
  },
  "build": {
    "appId": "com.elilopes.manager-nodejs",
    "productName": "Vite Project Manager",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "projects/**/*",
      "package.json"
    ]
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
